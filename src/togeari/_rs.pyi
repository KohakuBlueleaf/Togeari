"""Stubs of ``togeari._rs``, the native core (``src/togeari-rust``)."""

from typing import Any, TypedDict

class CoreInfo(TypedDict):
    version: str
    dispatcher: bool
    debug: bool

__version__: str
DISPATCHER: bool

def core_info() -> CoreInfo:
    """The extension: ``version``, ``dispatcher`` (the native dispatcher is built) and
    ``debug`` (a debug build)."""

def digest(value: Any) -> bytes:
    """``togeari.core.contracts.digest.digest``, fed natively for builtin values."""

def digest_with_weak(value: Any) -> tuple[bytes, list[str]]:
    """``togeari.core.contracts.digest.digest_with_weak``, fed natively for builtin values."""

def live_objects() -> dict[str, int]:
    """Live ``jobs``, ``strands``, ``inflights`` and ``slots`` of every core in the process."""

class Inbox:
    """The native dispatcher's inbox, with ``queue.SimpleQueue``'s interface."""

    def put(self, item: Any) -> None: ...
    def get(self, block: bool = True, timeout: float | None = None) -> Any: ...
    def get_nowait(self) -> Any: ...
    def empty(self) -> bool: ...
    def qsize(self) -> int: ...
    def drain(self) -> list: ...

class Owner:
    """What a work item's ``owner`` names: the statement's inflight id, its job (``job``, a
    ``JobView``; ``job_id``), instruction, order key, entry and lane; ``fate`` is
    ``"squashed"`` or ``"retired"`` once the statement left the window."""

    inf: int
    job_id: int
    instr: Any
    key: tuple
    entry: str
    lane: str | None
    fate: str | None
    job: Any

class Core:
    """The native dispatcher; ``togeari.core.runtime.native.NativeDispatcher`` subclasses it."""

    clock: Any
    def __init__(self, machine: Any, seed: int = 0) -> None: ...
    def _bind(self, inbox: Inbox) -> None: ...
    def cycle(self) -> None: ...
    def after_cycle(self) -> None: ...
    def next_timeout(self) -> float | None: ...
    def begin_stop(self, drain: bool) -> None: ...
    def event_error(self, kind: str, exc: BaseException) -> None: ...
    def start_job(self, item: Any, handle: Any = None) -> None: ...
    def deliver(self, item: Any, result: Any, unit: Any = None) -> None: ...
    def before_submit(self, lane: Any, unit: Any, items: list) -> list: ...
    def cancel_job(self, job: Any, message: str) -> None: ...
    def pause_job(self, job: Any) -> bool: ...
    def resume_job(self, job: Any) -> bool: ...
    def release_freed(self) -> None: ...
    def admit(self) -> None: ...
    def job_count(self) -> int: ...
    def window_total(self) -> int: ...
    def drain_dead(self) -> list[tuple[Any, str, list, Any]]: ...
    def native_stats(self) -> dict[str, int]:
        """GIL-free work: ``regions``, ``free_steps``, ``gil_steps``, ``free_orders``,
        ``gil_orders``, ``free_retires``, ``gil_retires``."""

    def inline_totals(self) -> dict[str, float]: ...
    @property
    def jobs(self) -> dict[int, Any]: ...
    @property
    def stats(self) -> dict: ...
    @property
    def pool_bytes(self) -> int: ...
    @property
    def ready(self) -> list[int]: ...
    @property
    def dirty(self) -> list[int]: ...
    def _job_info(self, id: int) -> tuple | None: ...
    def _job_window(self, id: int) -> list[tuple]: ...
    def _job_strands(self, id: int) -> list[tuple]: ...
    def _slot_counts(self, id: int) -> tuple[int, int]: ...

class Lane:
    """The native state of an adopted ``togeari.core.lanes.Lane``."""

    clock: Any
    up_version: int
    inflight: int
    def __init__(self, lane: Any) -> None: ...
    def _bind(self) -> None: ...
    def enqueue(self, item: Any, now: float) -> None: ...
    def pump(self, now: float) -> int: ...
    def timers(self, now: float) -> list[tuple[Any, Any]]: ...
    def next_deadline(self, now: float) -> float | None: ...
    def results(self, sub: int, results: list, now: float) -> list[tuple[Any, Any]]: ...
    def submission(self, sub: int) -> tuple[list, Any] | None: ...
    def remove(self, item: Any) -> bool: ...
    def cancel(self, item: Any) -> None: ...
    def attach(self, unit: Any) -> None: ...
    def detach(self, unit: Any, drain: bool, now: float) -> list: ...
    def unit_down(self, unit: Any, err: Any, now: float) -> None: ...
    def requeue_front(self, item: Any, now: float | None = None) -> None: ...
    def capacity_rose(self) -> None: ...
    def set_former(self, former: Any, now: float) -> None: ...
    def set_select(self, select: Any) -> None: ...
    def set_forming(self, forming: str) -> None: ...
    def set_max_inflight(self, value: Any) -> None: ...
    def set_timeout_s(self, value: Any) -> None: ...
    def set_lane_dead_s(self, value: Any) -> None: ...
    def set_retry(self, value: Any) -> None: ...
    def set_name(self, value: Any) -> None: ...
    def set_units(self, value: list) -> None: ...
    def set_overridden(self, name: str, on: bool) -> None: ...
    def units_up(self) -> list: ...
    def rate(self, unit: Any) -> float: ...
    def queued_now(self) -> int: ...
    def queued(self) -> int: ...
    def load_waiting(self) -> int: ...
    def signals(self) -> dict: ...
    def take_waits(self) -> list[float]: ...
    def under_cap(self) -> bool: ...
    def engine_identity(self) -> bytes: ...
    def queue(self) -> list: ...
    def unit_rows(self) -> list[tuple]: ...
    def stats(self) -> dict: ...
    def batch_sizes(self) -> dict: ...
    def subs(self) -> dict: ...
    def unit_state_name(self, unit: Any) -> str | None: ...

class Done:
    """What an engine calls when a submission settles: ``done(ticket, results)``."""

    def __call__(self, ticket: Any, results: list) -> None: ...

class Head:
    order: tuple
    item: Any
    live: bool
    bucket: Bucket

class Bucket:
    """A bucket of a native lane as a former written in Python reads it, live."""

    key: Any
    due: float | None
    cap: int | float
    def __len__(self) -> int: ...
    def head(self) -> Head | None: ...
    def items(self) -> list: ...
